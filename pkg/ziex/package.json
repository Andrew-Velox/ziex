{
  "name": "ziex",
  "version": "0.1.0-dev",
  "private": true,
  "description": "ZX is a framework for building web applications with Zig.",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "ziex": "bin/ziex"
  },
  "exports": {
    ".": "./index.js",
    "./react": "./react/index.js",
    "./wasm": "./wasm/index.js",
    "./wasm/init": "./wasm/init.js",
    "./cloudflare": "./cloudflare/index.js",
    "./aws-lambda": "./aws-lambda/index.js",
    "./vercel": "./vercel/index.js"
  },
  "homepage": "https://ziex.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziex-dev/ziex.git"
  },
  "keywords": [
    "zx",
    "zig",
    "web framework",
    "jsx",
    "react",
    "server components",
    "client components",
    "server actions",
    "client actions",
    "server actions"
  ],
  "author": "Nurul Huda (Apon) <me@nurulhudaapon.com>",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "build": "bun run script/build.ts",
    "publish": "bun run build && cd dist && bun publish",
    "fmt": "prettier --write . '!test/files/**' '!README.md'",
    "check": "tsc"
  },
  "dependencies": {
    "@ziex/cli": "0.1.0-dev"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "zzon": "^0.1.0-dev",
    "jsz": "github:nurulhudaapon/jsz",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "peerDependencies": {
    "typescript": "^0.1.0-dev",
    "react": ">=0.1.0-dev",
    "react-dom": ">=0.1.0-dev"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
